{
  "name": "xadrez",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "private": true,
  "type": "module",
  "description": "Chess game frontend (Vue 3 + TypeScript) for the Xadrez API"
}
